# FalkorDB Cloud: redis://<user>:<password>@<host>:<port> (the free tier has no TLS)
# Local Docker: redis://localhost:6379
FALKORDB_URL=redis://localhost:6379
# The scoreboard and agent eval keep a copy of each run here; tracegraph-seed stores them again
RESULTS_DIR=results

# Free endpoint used for development (GitHub Models serves gpt-4o-mini)
LLM_BASE_URL=https://models.github.ai/inference
LLM_API_KEY=your-github-token
LLM_MODEL=openai/gpt-4o-mini

# Optional paid endpoint for evals, the video and the live deploy
PAID_LLM_BASE_URL=https://api.openai.com/v1
PAID_LLM_API_KEY=
PAID_LLM_MODEL=gpt-4o-mini
USE_PAID_LLM=false
SPEND_LIMIT_USD=1.80

# live, record (live and saved to REPLAY_PATH) or replay (no LLM calls at all)
LLM_MODE=live
REPLAY_PATH=replays/demo.json

# udf (TRACE inside FalkorDB) or python; closed, open or unguarded
SCORER=udf
GUARD_MODE=closed

# HTTP API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
# The built web app (cd web && npm run build); the API serves it at / when it exists
WEB_DIR=web/dist
# Admin routes (seed, ring, guard, plug) are off while this is empty
ADMIN_TOKEN=
INVESTIGATOR_QUESTIONS_PER_VISITOR=10
# Serve the default buyer's MCP tools at /mcp as well as over stdio
MCP_OVER_HTTP=false
MCP_BUYER_ID=buyer-1
MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*"]
